# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.txt text

# Always have LF line endings on checkout. Windows accepts LF in Rust,
# JSON, and PowerShell. Bash does not accept CRLF.
run text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
